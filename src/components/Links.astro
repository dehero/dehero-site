---
import { Icon } from 'astro-icon/components';
import { getCurrentLanguage, LANGUAGE_DESCRIPTORS } from '../entities/languages';
import type { LinkInfo } from '../entities/services';

export interface Props {
  linkInfos: LinkInfo[];
}
const { linkInfos } = Astro.props;

const language = getCurrentLanguage(Astro.url);
const { strings } = LANGUAGE_DESCRIPTORS[language];
---

<ul class="list">
  {
    linkInfos.map((info) => (
      <li class="item">
        <a href={info.uri} class="link">
          <Icon name={info.service ?? 'site'} class:list={['icon', info.service]} />
          <p class="title">
            <span class="service">{info.service ? strings[info.service] : strings.site}</span>
            <span class="profile">{info.label}</span>
          </p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .list {
    display: grid;
    list-style: none;
    gap: 0.75rem 1rem;
    padding: 0;
    line-height: 1;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  .item {
    flex: 1 1 200px;
  }

  .link {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-link);
  }

  .link:hover {
    color: var(--color-link-hover);
  }

  .icon {
    font-size: 2rem;
  }

  .title {
    display: flex;
    flex-flow: column nowrap;
    margin: 0;
  }

  .service {
    font-size: 1rem;
    line-height: 2rem;
    text-decoration: underline;
  }

  .profile {
    font-size: 0.75rem;
  }
</style>
